# Server-only configuration. Never prefix these with VITE_.
# No emails are sent until explicitly enabled and all required values exist.
TERCIS_EMAIL_ENABLED=false
EMAIL_WORKER_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TERCIS_EMAIL_FROM=
TERCIS_APP_URL=

# No payment provider selected. Checkout and charges stay unavailable.
TERCIS_BILLING_ENABLED=false

# Existing antivirus worker: a trusted, authenticated ClamAV gateway is required.
CLAMAV_GATEWAY_URL=
CLAMAV_GATEWAY_SECRET=
ATTACHMENT_SCAN_WORKER_SECRET=
